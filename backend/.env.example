# ---- Core ----
APP_BEARER_TOKEN=change-me-to-a-long-random-string
CONVERSATION_DB_PATH=conversations.db

# ---- LLM ("the brain") ----
# A free option: Groq (OpenAI-compatible). Grab a key at console.groq.com.
LLM_PROVIDER=openai_compat
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_groq_key
OPENAI_MODEL=openai/gpt-oss-120b        # overrides each persona's model
#
# Or Anthropic direct:
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-xxx
#
# Or OmniRoute (mint a virtual key in its dashboard at http://localhost:20128):
# OPENAI_BASE_URL=http://localhost:20128/api/v1

# ---- STT ("the ears") — default: whisper ----
# The app is audio-first (it sends recorded audio). STT_PROVIDER defaults to
# "whisper"; blank WHISPER_* falls back to the OPENAI_* creds above, so a Groq
# key covers transcription too. No extra config needed if you use Groq.
# STT_PROVIDER=whisper
# WHISPER_BASE_URL=                       # defaults to OPENAI_BASE_URL
# WHISPER_API_KEY=                        # defaults to OPENAI_API_KEY
# WHISPER_MODEL=whisper-large-v3-turbo

# ---- TTS ("the voice") — default: kokoro ----
# Kokoro is free/local; the bundled personas ship real Kokoro voices. Run a
# Kokoro server exposing the OpenAI audio API (e.g. Kokoro-FastAPI):
KOKORO_BASE_URL=http://localhost:8880/v1
# KOKORO_API_KEY=                         # blank for local; set for a hosted Kokoro
# KOKORO_VOICE=af_heart                   # fallback when a persona has no kokoro_voice
#
# Or ElevenLabs (paid, best quality) — set a real per-persona voice_id in the
# persona YAMLs first:
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=xxx

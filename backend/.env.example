# ---- Core ----
APP_BEARER_TOKEN=change-me-to-a-long-random-string
CONVERSATION_DB_PATH=conversations.db

# ---- LLM ("the brain") ----
# Default: Anthropic direct.
ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_PROVIDER=claude

# Or route through an OpenAI-compatible gateway such as OmniRoute (cheaper/free
# models, one key for many providers). Configure a provider + mint a virtual key
# in the OmniRoute dashboard (http://localhost:20128) first, then:
# LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=http://localhost:20128/api/v1
# OPENAI_API_KEY=your-omniroute-virtual-key
# OPENAI_MODEL=the-model-omniroute-routes-on   # overrides each persona's model

# ---- TTS ("the voice") ----
# Default: ElevenLabs (best quality, paid).
ELEVENLABS_API_KEY=xxx
# TTS_PROVIDER=elevenlabs

# Or Kokoro (free/open, local or cheap-hosted). Run a Kokoro server that exposes
# the OpenAI audio API (e.g. Kokoro-FastAPI), then:
# TTS_PROVIDER=kokoro
# KOKORO_BASE_URL=http://localhost:8880/v1
# KOKORO_API_KEY=                       # blank for local; set for a hosted Kokoro
# KOKORO_VOICE=af_heart                 # fallback voice; personas set their own
